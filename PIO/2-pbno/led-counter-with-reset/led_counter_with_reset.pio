.program led_counter_with_reset

.wrap_target
  restart:
    set y, 0b1111
    jmp count

  restore:
    mov y, osr

  count:
    in pins, 2
    nop [10]
    mov x, isr
    jmp !x count

    mov osr, y
    set y, 0b0001
    jmp x!=y else
      set y, 0b0000
      mov pins, y
      jmp restart

    else:
      set y, 0b0010
      jmp x!=y restore 
        mov y, osr
        mov pins, !y
  jmp y-- count
.wrap

% c-sdk {
  
  void led_counter_with_reset_init(uint led_base_pin, uint led_pin_count, uint pbno_base_pin, uint pbno_pin_count, float div) {
    PIO pio = pio0;
    uint sm = pio_claim_unused_sm(pio, true);

    for (uint pin=led_base_pin; pin<led_base_pin+led_pin_count; pin++)
      pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, led_base_pin, led_pin_count, true);
    
    for (uint pin=pbno_base_pin; pin<pbno_base_pin+pbno_pin_count; pin++) {
      pio_gpio_init(pio, pin);
      gpio_pull_down(pin);
    }
    pio_sm_set_consecutive_pindirs(pio, sm, pbno_base_pin, pbno_pin_count, false);

    uint offset = pio_add_program(pio, &led_counter_with_reset_program);
    pio_sm_config config = led_counter_with_reset_program_get_default_config(offset);
    sm_config_set_clkdiv(&config, div);
    sm_config_set_in_pin_base(&config, pbno_base_pin);
    sm_config_set_in_pin_count(&config, pbno_pin_count);
    sm_config_set_out_pins(&config, led_base_pin, led_pin_count);
    pio_sm_init(pio, sm, offset, &config);

    pio_sm_set_enabled(pio, sm, true);
  }

%}
