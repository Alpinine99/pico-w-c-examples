.program toggle

  set x, 0b1010
  set y, 0xa
  mov pins, x
.wrap_target
  wait 1 pin 0
  set y, 0xa
  delay:
    jmp y-- delay [31]
  mov x, !x
  mov pins, x
  wait 0 pin 0
  set y, 0xa
  delay_1:
    jmp y-- delay_1 [31]
.wrap

% c-sdk {

  void toggle_init(uint led_base_pin, uint led_count, uint pbno_base_pin, uint pbno_count, float div) {
    PIO pio = pio0;
    uint sm = pio_claim_unused_sm(pio, true);

    // led configs
    for (uint pin=led_base_pin; pin<led_base_pin+led_count; pin++)
      pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, led_base_pin, led_count, true);

    // pbno config
    for (uint pin=pbno_base_pin; pin<pbno_base_pin+pbno_count; pin++) {
      pio_gpio_init(pio, pin);
      gpio_pull_down(pin);
    }
    pio_sm_set_consecutive_pindirs(pio, sm, pbno_base_pin, pbno_count, false);

    uint offset = pio_add_program(pio, &toggle_program);

    pio_sm_config config = toggle_program_get_default_config(offset);
    sm_config_set_clkdiv(&config, div);
    sm_config_set_out_pins(&config, led_base_pin, led_count);
    sm_config_set_in_pin_base(&config, pbno_base_pin);
    sm_config_set_in_pin_count(&config, pbno_count);

    pio_sm_init(pio, sm, offset, &config);
    pio_sm_set_enabled(pio, sm, true);
  }

%}
